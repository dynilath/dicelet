{
  "name": "dicelet",
  "version": "0.3.1",
  "description": "Dicelet dice expression parsing and evaluation engine",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "dicelet",
    "packageName": "dicelet",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">= 10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dynilath/dicelet"
  },
  "keywords": [
    "dice",
    "dicelet",
    "trpg",
    "roll",
    "napi-rs",
    "rust",
    "wasm"
  ],
  "author": "dynilath <dynilath@qq.com>",
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "artifacts": "napi artifacts",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "optionalDependencies": {
    "dicelet-win32-x64-msvc": "0.3.1",
    "dicelet-linux-x64-gnu": "0.3.1",
    "dicelet-linux-x64-musl": "0.3.1",
    "dicelet-linux-arm64-gnu": "0.3.1"
  }
}